# Postgres connection string from Neon (neon.tech, free tier).
# Without it the store runs on the built-in seed catalogue.
DATABASE_URL=

# Stripe test-mode keys (dashboard.stripe.com/test/apikeys). Test mode is free.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Owner password for /admin (min 8 characters). Visitors can always use the demo session.
ADMIN_PASSWORD=
# Optional key for signing admin cookies; falls back to ADMIN_PASSWORD or DATABASE_URL.
ADMIN_SESSION_SECRET=

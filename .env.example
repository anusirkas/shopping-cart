# Postgres connection string from Neon (neon.tech, free tier).
# Without it the store runs on the built-in seed catalogue.
DATABASE_URL=

# Stripe test-mode keys (dashboard.stripe.com/test/apikeys). Test mode is free.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin password for /admin (min 8 characters). Without it the admin is read-only.
ADMIN_PASSWORD=
